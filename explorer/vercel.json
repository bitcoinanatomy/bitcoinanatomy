{
  "rewrites": [
    {
      "source": "/api/btcnodes/:path*",
      "destination": "https://btcnodes.io/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/crypto.html",
      "destination": "/curve.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "xr-spatial-tracking=(*)" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
